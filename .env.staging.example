# hr-backend — staging template (hr-docs staging plan §4, step 3).
#
# This file is a REFERENCE only — every var name here documents what the
# staging container needs, with an obvious placeholder value. Nothing here
# is ever read directly by the running container: real secret values are
# resolved at container start from SSM by the shared entrypoint
# (hr-docs/infra/compose/entrypoint.sh), using the EC2 instance profile's
# credentials — never baked into an image, a repo, or this file. Non-secret
# values (URLs, flags, the RDS endpoint) ARE set directly in
# docker-compose.staging.yml's `environment:` block since they carry no
# confidentiality requirement.
#
# See hr-backend/.env.example for the local-dev version of every var and
# hr-docs/sprints/staging-env/plan.md §1.1 for the local→staging diff.

APP_NAME="HR Platform"
APP_ENV=staging
APP_DEBUG=false
# Set via SSM (entrypoint VAR=/hr-staging/hr-backend/app-key). Generated once
# by hr-docs/infra/05-ssm-params.sh — never typed by a human.
APP_KEY=__SET_VIA_SSM__
# The EIP or domain once one exists (staging plan §9 open question 1 — plain
# HTTP on the EIP for first bring-up).
APP_URL=http://__EIP__

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# RDS PostgreSQL 16 + pgvector. Host/port/db/user are NOT secret (the RDS SG
# only accepts connections from hr-staging-ec2-sg anyway) — set directly in
# docker-compose.staging.yml. Only the password is SSM-resolved.
DB_CONNECTION=pgsql
DB_HOST=hr-staging-db.__REGION__.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=hr_platform
DB_USERNAME=hr_staging_admin
DB_PASSWORD=__SET_VIA_SSM__

# The hr_ai Postgres role's password (ADR-0007) — read by the
# `create_hr_ai_role_and_chunk_indexes` migration at `migrate --force` time,
# same SSM value as hr-ai's own DATABASE_URL below (mapped to a DIFFERENT
# var name here — see entrypoint.sh's header comment).
HR_AI_DB_PASSWORD=__SET_VIA_SSM__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
# Gotcha (plan §1.1): .env.example leaves this `local` even though AWS_* vars
# are present. Staging MUST set `s3` explicitly or uploads silently hit the
# local disk.
FILESYSTEM_DISK=s3
# Gotcha (plan §1.1): `sync` runs jobs inline in-request — pointless with a
# worker container. Staging MUST use `database` so hr-backend-worker's
# `queue:work` actually does something.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Postmark not available yet (build-time decision) — MAIL_MAILER=log writes
# the rendered email (incl. the OTP code) to storage/logs/laravel.log.
# hr-docs/infra/compose/otp.sh reads it from there for login verification.
# Switch to `postmark` + set POSTMARK_API_KEY (real var name — see the
# POSTMARK_TOKEN/POSTMARK_API_KEY mismatch note in plan §1.1 / §9 item 6) the
# moment a Postmark account + sending domain exist. No other code change.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hr-platform.local"
MAIL_FROM_NAME="${APP_NAME}"
# POSTMARK_API_KEY=__SET_VIA_SSM__   # unused while MAIL_MAILER=log

# S3 — real bucket, no MinIO endpoint override, no path-style (ADR-0009:
# config only, same adapter as dev). AWS_ACCESS_KEY_ID/SECRET are DELIBERATELY
# left unset here — hr-backend's flysystem s3 driver already falls back to
# the EC2 instance profile's credential chain when they're empty (no code
# change needed on the hr-backend side, unlike hr-ai — see hr-ai's storage.py
# note for why that repo needed one).
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=hr-staging-documents-__ACCOUNT_ID__
# AWS_ENDPOINT unset → real S3. AWS_USE_PATH_STYLE_ENDPOINT unset → virtual-hosted style (default).

# hr-ai — internal Compose service name, not localhost.
HR_AI_URL=http://hr-ai:8001
HR_AI_INTERNAL_TOKEN=__SET_VIA_SSM__

SANCTUM_TOKEN_TTL_MINUTES=1440

# Same origin as the backend (Caddy serves both) — set to the EIP/domain.
FRONTEND_URL=http://__EIP__

# Seeded via `php artisan staging:seed-test-users` (hr-docs staging plan,
# Session 2) — real emails Pedram controls, not example.com.
SEED_ADMIN_EMAIL=__SET_ME__
SEED_EMPLOYEE_EMAIL=__SET_ME__
SEED_EDITOR_EMAIL=__SET_ME__
SEED_AUDITOR_EMAIL=__SET_ME__
SEED_HR_AGENT_EMAIL=__SET_ME__
